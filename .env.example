# Copy this file to .env and replace the placeholder values.
# Keep it in the project root, next to bot.py.

# Telegram bot
TELEGRAM_BOT_TOKEN=123456:ABCDEF_example_token
LOG_LEVEL=INFO

# Needed for large files (> 20 MB) when Bot API download is not enough
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdefghijklmnopqrstuvwxyz123456
TELETHON_SESSION=telethon_bot

# Hugging Face
HF_TOKEN=hf_your_token_here
# Optional, only if you want a custom cache folder
# HF_HOME=/path/to/.cache/huggingface

# Application mode and model settings
DOCKER_MODE=0
MODEL_NAME=ai-sage/GigaAM-v3
MODEL_REVISION=e2e_rnnt
ASR_BACKEND=onnx
ASR_MODEL=e2e_rnnt
ASR_SEGMENTATION_MODE=vad
ONNX_PROVIDER=auto
# ONNX_QUANTIZATION=int8
ONNX_MODEL_DIR=
ONNX_VAD_MODEL=silero
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_PREPROCESSING_MODE=auto
STATS_FILE=processing_stats.json

# Optional runtime tuning
CHUNK_SECONDS=900
LOG_RSS=1
